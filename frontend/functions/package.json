{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts src",
    "build": "tsc",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-fnd-perf",
    "shell": "npm run build && firebase functions:shell --project demo-fnd-perf",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project fatin-test",
    "logs": "firebase functions:log --project fatin-test"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.1",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
